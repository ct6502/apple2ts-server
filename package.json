{
  "name": "apple2ts-server",
  "private": true,
  "version": "0.1.0",
  "description": "Apple2TS integrated server and CLI",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:force": "node scripts/start.mjs --allow-missing-dist",
    "serve": "node server/server.mjs",
    "mcp:stdio": "node server/mcp_stdio.mjs",
    "cli": "node cli/index.mjs",
    "cli:help": "node cli/index.mjs --help",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0"
  }
}
